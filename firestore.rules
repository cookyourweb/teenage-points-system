rules_version = '2';

// REGLAS DE SEGURIDAD DE FIRESTORE
//
// Esto es lo que protege los datos de verdad. La guarda que hay en el
// navegador (`RutaDeMiFamilia`) es comodidad: evita llegar por accidente y da
// un mensaje decente. Pero vive en el cliente y quien quiera se la salta con
// las herramientas de desarrollo, o llamando a la API de Firestore
// directamente sin pasar por la aplicación.
//
// Estas reglas se ejecutan en el servidor de Google. No se saltan.
//
// POR QUÉ ESTE FICHERO ESTÁ EN EL REPOSITORIO:
// hasta ahora las reglas vivían solo en la consola de Firebase. Eso significa
// que nadie sabía cuáles eran sin entrar a mirar, no había historial de quién
// las cambió ni por qué, y no se podían revisar antes de aplicarlas. Una regla
// de seguridad es código: va versionada.
//
// CÓMO SE APLICAN (no basta con guardar el fichero):
//     firebase deploy --only firestore:rules
//
// Mientras no se despliegue, esto es un documento y no una protección.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudas ----------

    function haIniciadoSesion() {
      return request.auth != null;
    }

    function miDocumento() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // La pregunta que faltaba: ¿esta familia es la tuya?
    function esMiFamilia(familyId) {
      return haIniciadoSesion() && miDocumento().familyId == familyId;
    }

    function soyAdmin() {
      return haIniciadoSesion() && miDocumento().rol == 'admin';
    }

    // ---------- Usuarios ----------
    // Cada uno ve y edita su propio documento, y nada más.
    //
    // `rol` y `familyId` NO se pueden cambiar desde el cliente: si se
    // pudieran, cualquiera se ascendería a admin o se cambiaría de familia, y
    // todas las reglas de abajo dejarían de servir para nada.
    match /usuarios/{uid} {
      allow read: if haIniciadoSesion() && request.auth.uid == uid;

      allow update: if haIniciadoSesion()
                    && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol
                    && request.resource.data.familyId == resource.data.familyId;

      // Al crearse: sin campos de más, siempre `padre` (el admin se asigna a
      // mano, nunca desde el cliente) y solo en una familia donde ya figuras
      // como adulto. El alta crea la familia primero y el usuario después, así
      // que esa familia ya existe cuando llega este documento. Sin esto,
      // cualquiera se daba de alta como admin o en la familia de otro.
      allow create: if haIniciadoSesion()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                         ['nombre', 'email', 'rol', 'familyId', 'fechaCreacion'])
                    && request.resource.data.rol == 'padre'
                    && request.auth.uid in get(/databases/$(database)/documents/familias/$(request.resource.data.familyId)).data.miembros.padres;
      allow delete: if false;
    }

    // ---------- Familias ----------
    match /familias/{familyId} {
      allow read, update, delete: if esMiFamilia(familyId);

      // Crear: aún no existe `usuarios/{uid}`, así que `esMiFamilia` no sirve
      // (el alta crea la familia antes que el usuario). Se exige que el único
      // adulto sea quien la crea y que no traiga hijos: nadie puede fundar una
      // familia metiendo a otro dentro.
      allow create: if haIniciadoSesion()
                    && request.resource.data.miembros.padres.keys().hasOnly([request.auth.uid])
                    && request.resource.data.miembros.hijos.size() == 0;
    }

    // ---------- Puntos de la semana ----------
    // EL AGUJERO QUE SE CIERRA AQUÍ.
    //
    // El identificador del documento es `{familyId}_{childId}_{weekId}`, y el
    // dato lleva además `familyId` dentro. Se comprueba el CAMPO y no el
    // nombre del documento: el nombre es una cadena que se puede componer como
    // se quiera desde fuera, el campo es el dato.
    match /weeklyTasks/{docId} {
      allow read: if esMiFamilia(resource.data.familyId);

      allow create: if esMiFamilia(request.resource.data.familyId);

      // Y al actualizar se comprueban las DOS: la familia del documento que ya
      // existe y la del que se manda. Sin la segunda, alguien podría cambiarle
      // el familyId a un documento suyo y llevárselo a otra familia.
      allow update: if esMiFamilia(resource.data.familyId)
                    && esMiFamilia(request.resource.data.familyId);

      allow delete: if esMiFamilia(resource.data.familyId);
    }

    // ---------- Privilegios ----------
    match /privilegios/{privilegeId} {
      allow read: if esMiFamilia(resource.data.familyId);
      allow create: if esMiFamilia(request.resource.data.familyId);
      allow update: if esMiFamilia(resource.data.familyId)
                    && esMiFamilia(request.resource.data.familyId);
      allow delete: if esMiFamilia(resource.data.familyId);
    }

    // ---------- FAQs ----------
    // Leer necesita sesión. Antes se leía sin ella a propósito, para que un
    // padre pudiera mandarle el enlace de `/faqs` a un abuelo sin cuenta. Esa
    // decisión se revirtió: `categorias` guarda el contenido del método, que
    // es de su autor (Vicent Ginés Romero) y no nuestro para publicarlo.
    // Leerlo solo desde el backend llega con la sesión 4; hasta entonces, con
    // sesión.
    //
    // Escribir es otra cosa. Antes la ruta `/admin/faqs` solo comprobaba que
    // hubieras iniciado sesión, así que cualquiera con cuenta podía borrar las
    // FAQs de todas las familias. Un hijo incluido.
    match /categorias/{categoriaId} {
      allow read: if haIniciadoSesion();
      allow write: if soyAdmin();
    }

    // ---------- Todo lo demás ----------
    // Denegar por defecto. Una colección nueva no queda abierta por olvido:
    // hay que venir aquí y decidir quién la puede tocar.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
